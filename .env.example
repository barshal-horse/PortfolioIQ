# PortfolioIQ Environment Variables
# Copy to backend/.env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://portfolioiq:portfolioiq_pass@localhost:5432/portfolioiq

# Auth
JWT_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
DEFAULT_CURRENCY=USD
RISK_FREE_RATE=0.05

# Market Data (Phase 3+)
# ALPHA_VANTAGE_API_KEY=
# FMP_API_KEY=

# AI (Phases 10-12) — free tier: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# News (Phase 11+)
FINNHUB_API_KEY=darqfshr01qn6lvgnkbgdarqfshr01qn6lvgnkc0
NEWSAPI_API_KEY=pub_ebb11d4fc6524d5a830ed1884d5441e4

# Firebase Auth (Google sign-in) — Firebase console > Project settings
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Alpaca Broker Sync (paper trading by default)
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
